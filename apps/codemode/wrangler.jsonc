{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "deep-research-codemode",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "production",
    "API_UPSTREAM_URL": "http://127.0.0.1:8000"
  }
}
