# ==============================================================================
# Deep Research Agent - Unified Assistant Environment Configuration
# ==============================================================================

# 1. Model Providers (config/models.yaml roles: fast, strong, code)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# 2. Cloudflare Code Mode Tool Layer
# 'local' runs offline in Node.js subprocess sandbox with supervisor HTTP gate
# 'cloudflare' connects to the deployed Cloudflare Worker Dynamic Worker MCP endpoint
CODEMODE_BACKEND=local
CLOUDFLARE_WORKER_URL=http://127.0.0.1:8787/mcp
CLOUDFLARE_WORKER_TOKEN=cf_signed_tenant_token_secret

# 3. Search & Ingestion Layers
SEARXNG_URL=http://localhost:8080
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# 4. Temporal Graph Memory & Obsidian Vault
GRAPH_DB_URL=redis://localhost:6379
VAULT_ROOT=vault

# 5. Relational & Vector Storage (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://postgres:postgres_secure_password@localhost:5432/deep_research
DATABASE_URL_SYNC=postgresql://postgres:postgres_secure_password@localhost:5432/deep_research

# 6. Object Storage (MinIO S3)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_secure
MINIO_BUCKET=deep-research-artifacts
MINIO_SECURE=false

# 7. Agent Tracing & Observability (Langfuse)
LANGFUSE_PUBLIC_KEY=pk-lf-mock
LANGFUSE_SECRET_KEY=sk-lf-mock
LANGFUSE_HOST=http://localhost:3001

# 8. Web UI Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# 9. Multi-Tenant Defaults & Security
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=default_tenant