# LLM API Keys
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Search Providers
TAVILY_API_KEY=your_tavily_api_key_here
EXA_API_KEY=your_exa_api_key_here

# Reddit (optional)
REDDIT_CLIENT_ID=your_reddit_client_id
REDDIT_CLIENT_SECRET=your_reddit_client_secret
REDDIT_USER_AGENT=deep-research-agent/1.0

# Sandbox (E2B optional, falls back to local subprocess/docker)
E2B_API_KEY=your_e2b_api_key_here

# Database
DATABASE_URL=postgresql+asyncpg://app_user:app_password@postgres:5432/deep_research
DATABASE_URL_SYNC=postgresql://app_user:app_password@postgres:5432/deep_research

# MinIO / Object Storage (S3 API)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=deep-research-artifacts
MINIO_SECURE=false

# Observability
LANGFUSE_PUBLIC_KEY=pk-lf-mock
LANGFUSE_SECRET_KEY=sk-lf-mock
LANGFUSE_HOST=http://langfuse:3000

# App Settings
APP_ENV=development
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=tenant_default